# OpenAI API key. When set, Aido calls OpenAI directly.
OPENAI_API_KEY=
# Optional: override the OpenAI model.
OPENAI_MODEL=gpt-6.1-sol

# Supabase project (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Optional: public origin for email links when it differs from the request host.
NEXT_PUBLIC_SITE_URL=

# Official French mission source. Request a free key at https://api-engagement.beta.gouv.fr/#contact
# When empty, Aido falls back to the unofficial MANA relay (development only).
API_ENGAGEMENT_API_KEY=

# Allow the test numbers W000000000 / 000000000 to create unverified demo organizations outside development.
# Leave unset in real production.
ALLOW_DEMO_ORGANIZATIONS=

# Brevo transactional email (application, decision and message notifications).
# API key: Brevo > SMTP & API > API keys. The sender address must be verified in Brevo (Senders).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Aido
